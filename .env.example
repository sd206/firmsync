NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: sender for storage warning emails (needs a domain verified in Resend, and RESEND_API_KEY).
NOTIFY_FROM=
# Optional: bare address invoices are emailed from (e.g. invoices@yourdomain.com, on the Resend-verified
# domain). Falls back to the address in NOTIFY_FROM. Without either, Email invoice is switched off.
INVOICE_EMAIL_FROM=
# Local only: send all app email to the Mailpit bundled with local Supabase (http://127.0.0.1:54424)
# instead of Resend. Never set this in production.
# EMAIL_TRANSPORT=mailpit
