NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The app's own address; invite and sign-in links are built from it. Production: https://app.veritreo.com
# (https://firmsync.vercel.app until the switch). In production (VERCEL_ENV=production) it must be an
# https:// origin with no path. Vercel applies a change only to new deployments: redeploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Which site this is. Test site (test.veritreo.com): test — shows the TEST SITE bar on every page and puts
# "[TEST] " on tab titles and app email subjects. Prod and local: leave unset. Built into the app at build
# time: a change needs a redeploy (locally, a restart or rebuild).
# NEXT_PUBLIC_APP_ENV=
# Optional: sender for storage warning emails (needs a domain verified in Resend, and RESEND_API_KEY).
# Production: VeriTreo <alerts@veritreo.com>
NOTIFY_FROM=
# Optional: bare address invoices are emailed from (on the Resend-verified domain; production:
# invoices@veritreo.com). Falls back to the address in NOTIFY_FROM. Without either, Email invoice is switched off.
INVOICE_EMAIL_FROM=
# Bill inbox (production only; see README "Bill inbox"): RESEND_API_KEY, RESEND_INBOUND_SECRET and
# INBOUND_DOMAINS, first domain shown to users, e.g. in.veritreo.com,<id>.resend.app
# INBOUND_DOMAINS=
# Local only: send all app email to the Mailpit bundled with local Supabase (http://127.0.0.1:54424)
# instead of Resend. Never set this in production.
# EMAIL_TRANSPORT=mailpit
